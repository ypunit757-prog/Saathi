# Copy to .env for local testing (python-dotenv is not required; export these in your shell instead).
# On Render, enter them in Dashboard -> Environment. Never commit real keys.
SAATHI_LLM=cloud
SAATHI_CLOUD_API_KEY=            # Google AI Studio key for Gemma (or any OpenAI-compatible provider)
SAATHI_CLOUD_MODEL=gemma-3-27b-it
# SAATHI_CLOUD_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
SAATHI_PASSWORD=                 # REQUIRED for a public URL
SENTRY_DSN=
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
SERPAPI_API_KEY=
